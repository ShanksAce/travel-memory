{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "travel-memory",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-memory-db",
      "database_id": "f76397e2-dc2a-4a6d-a0c6-e87808876201"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "travel-memory-photos"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "andy950721@gmail.com",
    "OWNER_NAME": "Ace Shanks",
    "OWNER_USER_ID": "owner"
  },
  "observability": {
    "enabled": true
  }
}
